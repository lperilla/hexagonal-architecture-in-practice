<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ajustes de Maven del proyecto. Se cargan desde .mvn/maven.config y sustituyen
  al settings.xml del usuario, de modo que la construcción descarga siempre de
  Maven Central, sin mirrors corporativos, y es reproducible en cualquier máquina.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
</settings>
